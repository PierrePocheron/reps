<?xml version="1.0" encoding="utf-8"?>
<!-- Interdit tout trafic HTTP en clair (l'app ne parle qu'en HTTPS :
     Firebase, CDN jsDelivr, Sentry). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
