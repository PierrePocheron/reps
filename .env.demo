# Mode démo (yarn dev:demo) : émulateurs Firebase locaux, projet fictif « demo-reps ».
# Aucune vraie clé ici — ces valeurs écrasent celles de .env.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-reps.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-reps
VITE_FIREBASE_STORAGE_BUCKET=demo-reps.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MEASUREMENT_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_SENTRY_DSN=
VITE_LEGAL_NAME=Éditeur de démo
VITE_CONTACT_EMAIL=contact@example.com
