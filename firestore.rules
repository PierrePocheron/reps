rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Une demande d'ami (ID déterministe `${from}_${to}`) au statut donné
    // existe-t-elle entre a et b, dans un sens ou l'autre ?
    // NB : les get()/exists() d'un batch voient l'état AVANT le batch.
    // State once the current write (or batch) is applied: the app accepts a request and links both friends lists
    // in ONE batch, where get() would still see the request as pending
    function requestBetweenAfter(a, b, statuses) {
      return (existsAfter(/databases/$(database)/documents/friend_requests/$(a + '_' + b))
                && getAfter(/databases/$(database)/documents/friend_requests/$(a + '_' + b)).data.status in statuses)
          || (existsAfter(/databases/$(database)/documents/friend_requests/$(b + '_' + a))
                && getAfter(/databases/$(database)/documents/friend_requests/$(b + '_' + a)).data.status in statuses);
    }

    // Friends' feed sorts sessions and events by createdAt and lists their exercises: one value of the wrong
    // type threw for every friend. Checked when present only (legacy docs may lack them).
    function feedFieldsTyped(d) {
      return d.get('createdAt', request.time) is timestamp
        && d.get('exercises', []) is list
        && d.get('totalReps', 0) is number;
    }

    // ─── users ──────────────────────────────────────────────────────────────
    // Le doc public ne doit contenir AUCUNE donnée sensible : les champs
    // privés (email, fcmToken, poids, taille, date de naissance, genre)
    // vivent dans users/{uid}/private/* (owner-only).

    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && validUserDoc(request.resource.data)
        && request.resource.data.friends == [];

      // Propriétaire : tout le doc (validé).
      // Autre partie d'une demande acceptée : UNIQUEMENT le champ friends,
      // pour s'ajouter ou se retirer lui-même (acceptation / suppression d'ami).
      allow update: if (isOwner(userId) && validUserDoc(request.resource.data))
                    || friendLinkUpdate(userId);

      allow delete: if isOwner(userId);

      function validUserDoc(d) {
        return d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50
          && d.totalReps is number && d.totalReps >= 0
          && d.totalSessions is number && d.totalSessions >= 0
          && d.badges is list && d.badges.size() <= 300
          && d.friends is list && d.friends.size() <= 500
          && (!('searchName' in d) || (d.searchName is string && d.searchName.size() <= 50))
          && (!('firstName' in d) || (d.firstName is string && d.firstName.size() <= 50))
          && (!('lastName' in d) || (d.lastName is string && d.lastName.size() <= 50))
          && (!('avatarEmoji' in d) || (d.avatarEmoji is string && d.avatarEmoji.size() <= 16))
          && (!('emailHash' in d) || (d.emailHash is string && d.emailHash.size() == 64))
          // every search and friends list downloads this doc: the lists the app writes stay small (generous caps)
          && (!('newBadgeIds' in d) || (d.newBadgeIds is list && d.newBadgeIds.size() <= 300))
          && (!('exercisesDistribution' in d) || (d.exercisesDistribution is list && d.exercisesDistribution.size() <= 500))
          && (!('repButtons' in d) || (d.repButtons is list && d.repButtons.size() <= 20))
          // Interdits dans le doc public (ils vont dans private/*)
          && !('email' in d) && !('fcmToken' in d)
          && !('weight' in d) && !('height' in d)
          && !('birthDate' in d) && !('gender' in d);
      }

      function friendLinkUpdate(userId) {
        let added = request.resource.data.friends.toSet().difference(resource.data.friends.toSet());
        let removed = resource.data.friends.toSet().difference(request.resource.data.friends.toSet());
        return isAuthenticated()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
          // il s'ajoute lui-même (acceptation) ou se retire lui-même (suppression)
          && (
            (added == [request.auth.uid].toSet() && removed.size() == 0
              && requestBetweenAfter(request.auth.uid, userId, ['accepted']))
            || (removed == [request.auth.uid].toSet() && added.size() == 0)
          );
      }

      // Données privées du compte : token FCM, email, mensurations…
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // User Events (badges, feed) — écrits par le propriétaire,
      // lisibles par les authentifiés (feed social, voir collection group).
      match /userEvents/{eventId} {
        allow read: if isAuthenticated();
        // the feed attributes an event to its userId field: it may only name the path owner
        allow create, update: if isOwner(userId) && request.resource.data.get('userId', userId) == userId
          && feedFieldsTyped(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // ─── user_challenges ─────────────────────────────────────────────────────
    match /user_challenges/{challengeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        // the app keeps the exercise in definitionSnapshot (a top-level exerciseId was required: every join was denied)
        && request.resource.data.definitionSnapshot is map
        && request.resource.data.definitionSnapshot.exerciseId is string
        && request.resource.data.definitionSnapshot.exerciseId.size() <= 80
        && request.resource.data.history is list;
      // userId stays the owner's: a challenge handed to another account filled their 6 active slots
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── friend_requests ─────────────────────────────────────────────────────
    // ID déterministe obligatoire : `${fromUserId}_${toUserId}`.
    // Empêche les doublons et permet les get() ciblés dans les règles.
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);

      allow create: if isAuthenticated()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUserId
        && request.resource.data.status == 'pending'
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() <= 50
        // the recipient's listener sorts by createdAt (sendFriendRequest stamps serverTimestamp())
        && request.resource.data.createdAt == request.time;

      // Seul le DESTINATAIRE répond, et uniquement sur le champ status.
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.toUserId
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];

      // Annulation (expéditeur), nettoyage ou suppression de compte (les deux).
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
    }

    // ─── sessions (renforcement) ────────────────────────────────────────────
    // Lecture authentifiée : assumé pour le feed social entre amis
    // (contenu : reps/durée/exercices — pas de PII).
    match /sessions/{userId}/userSessions/{sessionId} {
      allow read: if isAuthenticated();
      // the feed and the leaderboards attribute a session to its userId field: it may only name the path owner
      allow create, update: if isOwner(userId) && request.resource.data.get('userId', userId) == userId
        && feedFieldsTyped(request.resource.data);
      allow delete: if isOwner(userId);

      // Encouragements (kudos, comme Strava) : l'ID du document est celui de l'ami qui encourage
      // → une seule réaction par personne et par séance ; pas sur sa propre séance ; amis uniquement.
      match /kudos/{fromId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.auth.uid == fromId
          && fromId != userId
          && get(/databases/$(database)/documents/users/$(userId)).data.friends.hasAny([request.auth.uid])
          && request.resource.data.keys().hasOnly(['createdAt', 'fromUid'])
          && request.resource.data.fromUid == fromId
          && request.resource.data.createdAt == request.time;
        // the giver withdraws it; the session owner may too (deleting their account removes the kudos they received)
        allow delete: if isAuthenticated() && (request.auth.uid == fromId || request.auth.uid == userId);
      }
    }

    // Kudos one has given, found by collection group query (fromUid) to delete them with the account
    match /{path=**}/kudos/{fromId} {
      allow read: if isAuthenticated();
    }

    match /{path=**}/userSessions/{sessionId} {
      allow read: if isAuthenticated();
    }

    match /{path=**}/userEvents/{eventId} {
      allow read: if isAuthenticated();
    }

    // ─── gym_sessions (musculation) ─────────────────────────────────────────
    match /gym_sessions/{userId}/userGymSessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // ─── userTemplates ──────────────────────────────────────────────────────
    // Modèles perso : lisibles par les amis pour les copier (Hevy), modifiables par le propriétaire seul
    match /userTemplates/{userId}/templates/{templateId} {
      allow read: if isOwner(userId)
        || (isAuthenticated() && get(/databases/$(database)/documents/users/$(userId)).data.friends.hasAny([request.auth.uid]));
      allow write: if isOwner(userId);
    }

    // ─── exercises (personnalisés) ──────────────────────────────────────────
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── default_exercises (héritage, lecture seule) ────────────────────────
    match /default_exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── notifications ──────────────────────────────────────────────────────
    // Création : en son propre nom, vers soi ou vers un ami. Une demande en attente ne suffit plus : un inconnu
    // pouvait spammer n'importe qui (la notif d'acceptation part après le batch, les listes d'amis sont déjà liées).
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isAuthenticated()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.type is string && request.resource.data.type.size() <= 40
        && request.resource.data.read == false
        // the home kudos banner shows fromName; the app stamps createdAt with serverTimestamp()
        && (!('fromName' in request.resource.data) || (request.resource.data.fromName is string && request.resource.data.fromName.size() <= 50))
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.friends.hasAny([request.auth.uid])
        );

      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId);
    }

    // ─── phrases (contenu public en lecture) ────────────────────────────────
    match /phrases/{phraseId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
