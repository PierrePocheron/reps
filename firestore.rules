rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Une demande d'ami (ID déterministe `${from}_${to}`) au statut donné
    // existe-t-elle entre a et b, dans un sens ou l'autre ?
    // NB : les get()/exists() d'un batch voient l'état AVANT le batch.
    // State once the current write (or batch) is applied: the app accepts a request and links both friends lists
    // in ONE batch, where get() would still see the request as pending
    function requestBetweenAfter(a, b, statuses) {
      return (existsAfter(/databases/$(database)/documents/friend_requests/$(a + '_' + b))
                && getAfter(/databases/$(database)/documents/friend_requests/$(a + '_' + b)).data.status in statuses)
          || (existsAfter(/databases/$(database)/documents/friend_requests/$(b + '_' + a))
                && getAfter(/databases/$(database)/documents/friend_requests/$(b + '_' + a)).data.status in statuses);
    }

    // Keys a write sets: all of them on create, only the changed ones on update (older docs keep the fields they have)
    function writtenKeys() {
      return resource == null ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys();
    }

    function shortString(d, key, max) {
      return d.get(key, '') is string && d.get(key, '').size() <= max;
    }

    function boundedNumber(d, key, max) {
      return d.get(key, 0) is number && d.get(key, 0) >= 0 && d.get(key, 0) <= max;
    }

    // Friends' feed keeps the newest 20 sessions and events by createdAt per query and renders their fields; the
    // leaderboards sum every session dated in the period. One ill-typed, oversized or future-dated doc crashed,
    // pinned or skewed them for every friend. Only the keys the app writes; values checked when present (legacy
    // docs may lack them). Exercise items stay unchecked (rules cannot loop over a list): the client filters them.
    function feedDocOk(keys) {
      let d = request.resource.data;
      return writtenKeys().hasOnly(keys)
        // createdAt is the server's clock (serverTimestamp()) and never moves afterwards
        && (resource == null
              ? (d.get('createdAt', null) == request.time || challengeClock(d))
              : d.get('createdAt', null) == resource.data.get('createdAt', null))
        // date comes from the phone's clock (and a queued write refused offline is a lost session): a day of slack
        && d.get('date', request.time) is timestamp
        && d.get('date', request.time) <= request.time + duration.value(1, 'd')
        && d.get('exercises', []) is list && d.get('exercises', []).size() <= 100
        && d.get('duration', 0) is number
        && boundedNumber(d, 'totalReps', 100000) && boundedNumber(d, 'totalCalories', 100000)
        && shortString(d, 'sessionId', 128) && shortString(d, 'category', 40) && shortString(d, 'challengeId', 80)
        && shortString(d, 'type', 40) && shortString(d, 'badgeId', 80) && shortString(d, 'badgeName', 50)
        && shortString(d, 'badgeEmoji', 16) && shortString(d, 'friendId', 128) && shortString(d, 'friendName', 50);
    }

    // validateChallengeDay stamps createdAt with the phone's clock inside its transaction (older versions too):
    // a little ahead of the server is tolerated, not enough to hold the top of a feed
    function challengeClock(d) {
      return d.get('category', '') == 'challenge' && d.get('createdAt', null) is timestamp
        && d.createdAt <= request.time + duration.value(10, 'm');
    }

    // ─── users ──────────────────────────────────────────────────────────────
    // Le doc public ne doit contenir AUCUNE donnée sensible : les champs
    // privés (email, fcmToken, poids, taille, date de naissance, genre)
    // vivent dans users/{uid}/private/* (owner-only).

    match /users/{userId} {
      allow get: if isAuthenticated();
      // one unbounded list downloaded every profile (names, emailHash, friends) in one go: only bounded queries,
      // like the app's (friends by 10, search by 10, e-mail by 1)
      allow list: if isAuthenticated() && request.query.limit <= 30;

      allow create: if isOwner(userId)
        && validUserDoc(request.resource.data)
        && request.resource.data.friends == [];

      // Propriétaire : tout le doc (validé).
      // Autre partie d'une demande acceptée : UNIQUEMENT le champ friends,
      // pour s'ajouter ou se retirer lui-même (acceptation / suppression d'ami).
      allow update: if (isOwner(userId) && validUserDoc(request.resource.data))
                    || friendLinkUpdate(userId);

      allow delete: if isOwner(userId);

      function validUserDoc(d) {
        return d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50
          // the « Légendes » leaderboard ranks friends by these totals (1e308 or Infinity topped it)
          && d.totalReps is number && d.totalReps >= 0 && d.totalReps <= 100000000
          && d.totalSessions is number && d.totalSessions >= 0 && d.totalSessions <= 1000000
          && d.badges is list && d.badges.size() <= 300
          && d.friends is list && d.friends.size() <= 500
          && (!('searchName' in d) || (d.searchName is string && d.searchName.size() <= 50))
          && (!('firstName' in d) || (d.firstName is string && d.firstName.size() <= 50))
          && (!('lastName' in d) || (d.lastName is string && d.lastName.size() <= 50))
          && (!('avatarEmoji' in d) || (d.avatarEmoji is string && d.avatarEmoji.size() <= 16))
          // the e-mail search is an exact match on emailHash: a hash the client chose let anyone be found as someone
          // else. A new or changed one is the hash of the account's own e-mail (hashEmail: SHA-256 hex, lowercased)
          && (!('emailHash' in d)
              || (resource != null && d.emailHash == resource.data.get('emailHash', null))
              || d.emailHash == hashing.sha256(request.auth.token.email.lower()).toHexString().lower())
          // every search and friends list downloads this doc: the lists the app writes stay small (generous caps)
          && (!('newBadgeIds' in d) || (d.newBadgeIds is list && d.newBadgeIds.size() <= 300))
          && (!('exercisesDistribution' in d) || (d.exercisesDistribution is list && d.exercisesDistribution.size() <= 500))
          && (!('repButtons' in d) || (d.repButtons is list && d.repButtons.size() <= 20))
          // Interdits dans le doc public (ils vont dans private/*)
          && !('email' in d) && !('fcmToken' in d)
          && !('weight' in d) && !('height' in d)
          && !('birthDate' in d) && !('gender' in d);
      }

      function friendLinkUpdate(userId) {
        let added = request.resource.data.friends.toSet().difference(resource.data.friends.toSet());
        let removed = resource.data.friends.toSet().difference(request.resource.data.friends.toSet());
        return isAuthenticated()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
          // sets do not see duplicates: hundreds of copies of another friend went over the 500 cap and locked every
          // write of the owner's own profile. One more entry at most (an older list with duplicates stays valid)
          && request.resource.data.friends.size() <= resource.data.friends.size() + 1
          // il s'ajoute lui-même (acceptation) ou se retire lui-même (suppression)
          && (
            (added == [request.auth.uid].toSet() && removed.size() == 0
              && requestBetweenAfter(request.auth.uid, userId, ['accepted']))
            || (removed == [request.auth.uid].toSet() && added.size() == 0)
          );
      }

      // Données privées du compte : token FCM, email, mensurations…
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // User Events (badges, feed) — écrits par le propriétaire,
      // lisibles par les authentifiés (feed social, voir collection group).
      match /userEvents/{eventId} {
        allow read: if isAuthenticated();
        // the feed attributes an event to its userId field: it may only name the path owner
        allow create, update: if isOwner(userId) && request.resource.data.get('userId', userId) == userId
          && feedDocOk(['userId', 'type', 'badgeId', 'badgeName', 'badgeEmoji', 'friendId', 'friendName', 'createdAt']);
        allow delete: if isOwner(userId);
      }
    }

    // ─── user_challenges ─────────────────────────────────────────────────────
    match /user_challenges/{challengeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        // the app keeps the exercise in definitionSnapshot (a top-level exerciseId was required: every join was denied)
        && request.resource.data.definitionSnapshot is map
        && request.resource.data.definitionSnapshot.exerciseId is string
        && request.resource.data.definitionSnapshot.exerciseId.size() <= 80
        && request.resource.data.history is list;
      // userId stays the owner's: a challenge handed to another account filled their 6 active slots
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── friend_requests ─────────────────────────────────────────────────────
    // ID déterministe obligatoire : `${fromUserId}_${toUserId}`.
    // Empêche les doublons et permet les get() ciblés dans les règles.
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);

      allow create: if isAuthenticated()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUserId
        && request.resource.data.status == 'pending'
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() <= 50
        // the recipient's permanent listener downloads every pending request and renders the emoji: one of ~1 MB, or
        // a map that crashed the Friends page, was accepted from any account. Only what sendFriendRequest writes
        && request.resource.data.keys().hasOnly(['fromUserId', 'toUserId', 'status', 'fromDisplayName', 'fromAvatarEmoji', 'createdAt'])
        && (!('fromAvatarEmoji' in request.resource.data)
            || (request.resource.data.fromAvatarEmoji is string && request.resource.data.fromAvatarEmoji.size() <= 16))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.toUserId))
        // the recipient's listener sorts by createdAt (sendFriendRequest stamps serverTimestamp())
        && request.resource.data.createdAt == request.time;

      // Seul le DESTINATAIRE répond, et uniquement sur le champ status.
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.toUserId
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected'];

      // Annulation (expéditeur), nettoyage ou suppression de compte (les deux).
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
    }

    // ─── sessions (renforcement) ────────────────────────────────────────────
    // Lecture authentifiée : assumé pour le feed social entre amis
    // (contenu : reps/durée/exercices — pas de PII).
    match /sessions/{userId}/userSessions/{sessionId} {
      allow read: if isAuthenticated();
      // the feed and the leaderboards attribute a session to its userId field: it may only name the path owner
      allow create, update: if isOwner(userId) && request.resource.data.get('userId', userId) == userId
        && feedDocOk(['userId', 'date', 'duration', 'exercises', 'totalReps', 'totalCalories', 'createdAt',
          'sessionId', 'category', 'challengeId']);
      allow delete: if isOwner(userId);

      // Encouragements (kudos, comme Strava) : l'ID du document est celui de l'ami qui encourage
      // → une seule réaction par personne et par séance ; pas sur sa propre séance ; amis uniquement.
      match /kudos/{fromId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.auth.uid == fromId
          && fromId != userId
          // on an existing session only: account deletion finds received kudos through the owner's sessions
          && exists(/databases/$(database)/documents/sessions/$(userId)/userSessions/$(sessionId))
          && get(/databases/$(database)/documents/users/$(userId)).data.friends.hasAny([request.auth.uid])
          && request.resource.data.keys().hasOnly(['createdAt', 'fromUid'])
          && request.resource.data.fromUid == fromId
          && request.resource.data.createdAt == request.time;
        // the giver withdraws it; the session owner may too (deleting their account removes the kudos they received)
        allow delete: if isAuthenticated() && (request.auth.uid == fromId || request.auth.uid == userId);
      }
    }

    // Kudos one has given, found by collection group query (fromUid) to delete them with the account
    match /{path=**}/kudos/{fromId} {
      allow read: if isAuthenticated();
    }

    match /{path=**}/userSessions/{sessionId} {
      allow read: if isAuthenticated();
    }

    match /{path=**}/userEvents/{eventId} {
      allow read: if isAuthenticated();
    }

    // ─── gym_sessions (musculation) ─────────────────────────────────────────
    match /gym_sessions/{userId}/userGymSessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // ─── userTemplates ──────────────────────────────────────────────────────
    // Modèles perso : lisibles par les amis pour les copier (Hevy), modifiables par le propriétaire seul
    match /userTemplates/{userId}/templates/{templateId} {
      allow read: if isOwner(userId)
        || (isAuthenticated() && get(/databases/$(database)/documents/users/$(userId)).data.friends.hasAny([request.auth.uid]));
      // friends list them and « Copier » duplicates every field into their own: only the template fields, bounded
      // (changed keys on update: older templates stay editable)
      allow create, update: if isOwner(userId)
        && writtenKeys().hasOnly(['name', 'description', 'emoji', 'workoutType', 'exerciseIds', 'muscuExercises', 'userId', 'createdAt'])
        && shortString(request.resource.data, 'name', 100) && shortString(request.resource.data, 'description', 300)
        && shortString(request.resource.data, 'emoji', 16) && shortString(request.resource.data, 'workoutType', 20)
        && shortString(request.resource.data, 'userId', 128)
        && request.resource.data.get('exerciseIds', []) is list && request.resource.data.get('exerciseIds', []).size() <= 100
        && request.resource.data.get('muscuExercises', []) is list && request.resource.data.get('muscuExercises', []).size() <= 100
        && request.resource.data.get('createdAt', request.time) is timestamp;
      allow delete: if isOwner(userId);
    }

    // ─── exercises (personnalisés) ──────────────────────────────────────────
    match /exercises/{exerciseId} {
      // the app reads its own only (getUserExercises, account deletion): any account listed everyone's
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── default_exercises (héritage, lecture seule) ────────────────────────
    match /default_exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── notifications ──────────────────────────────────────────────────────
    // Création : en son propre nom, vers soi ou vers un ami. Une demande en attente ne suffit plus : un inconnu
    // pouvait spammer n'importe qui (la notif d'acceptation part après le batch, les listes d'amis sont déjà liées).
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isAuthenticated()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        // the home banner reads every unread kudos notification and queries the kudos of each sessionId: a friend
        // piled up ~1 MB ones, of any type, with invented sessions. Only what giveKudos / acceptFriendRequest write,
        // and a kudos notification only for a kudos that exists (giveKudos writes it first)
        && request.resource.data.keys().hasOnly(['userId', 'fromUserId', 'fromName', 'type', 'read', 'sessionId', 'title', 'message', 'createdAt'])
        && request.resource.data.type in ['kudos', 'friend_activity']
        && (!('sessionId' in request.resource.data)
            || (request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 128))
        && (request.resource.data.type != 'kudos' || (request.resource.data.get('sessionId', null) is string
            && exists(/databases/$(database)/documents/sessions/$(request.resource.data.userId)/userSessions/$(request.resource.data.sessionId)/kudos/$(request.auth.uid))))
        && request.resource.data.read == false
        // the home kudos banner shows fromName; the app stamps createdAt with serverTimestamp()
        && (!('fromName' in request.resource.data) || (request.resource.data.fromName is string && request.resource.data.fromName.size() <= 50))
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.friends.hasAny([request.auth.uid])
        );

      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId);
    }

    // ─── phrases (contenu public en lecture) ────────────────────────────────
    match /phrases/{phraseId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
